	"Destructuring info user": {
		"scope": "javascript,typescript",
		"prefix": "mtu",
		"body": [
			"const { _id: userID } = ctx.meta.infoUser;",
		],
		"description": "Destructuring info user"
	},
	"Render status code and response": {
		"scope": "javascript,typescript",
		"prefix": "rds",
		"body": [
			"return renderStatusCodeAndResponse({ resultAfterCallHandler, ctx });",
		],
		"description": "Render status code and response"
	},
	"Render status code and response (error)": {
		"scope": "javascript,typescript",
		"prefix": "rdse",
		"body": [
			"return renderStatusCodeAndResponse({ error_message: error.message, ctx });",
		],
		"description": "Render status code and response (error)"
	},
	"Resolve response in model": {
		"scope": "javascript,typescript",
		"prefix": "rse",
		"body": [
			"return resolve({",
			"\terror: true,",
			"\tmessage: 'Là lỗi của chúng tôi không phải của bạn, chúng tôi đang tìm cách khắc phục',",
			"\tkeyError: 'error_occurred',",
			"\tstatus: 422",
			"});"
		],
		"description": "Resolve response in model"
	},
	"Resolve response in model (server error)": {
		"scope": "javascript,typescript",
		"prefix": "rsse",
		"body": [
			"return resolve({ error: true, message: error.message, status: 500 });"
		],
		"description": "Resolve response in model (server error)"
	},
}